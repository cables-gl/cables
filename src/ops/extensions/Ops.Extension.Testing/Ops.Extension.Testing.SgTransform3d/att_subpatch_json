          "name": "Final Code",
          "value": "\nIN vec2 texCoord;\nmat4 transform3d(mat4 m, vec3 translation, vec3 rotation, vec3 scale)\n{\n    rotation=radians(rotation);\n    float cx = cos(rotation.x), sx = sin(rotation.x);\n    float cy = cos(rotation.y), sy = sin(rotation.y);\n    float cz = cos(rotation.z), sz = sin(rotation.z);\n    mat4 trs;\n\n    trs[0][0] = (cy * cz) * scale.x;\n    trs[0][1] = (cy * sz) * scale.x;\n    trs[0][2] = (-sy) * scale.x;\n    trs[0][3] = 0.0;\n\n    trs[1][0] = (sx * sy * cz - cx * sz) * scale.y;\n    trs[1][1] = (sx * sy * sz + cx * cz) * scale.y;\n    trs[1][2] = (sx * cy) * scale.y;\n    trs[1][3] = 0.0;\n\n    trs[2][0] = (cx * sy * cz + sx * sz) * scale.z;\n    trs[2][1] = (cx * sy * sz - sx * cz) * scale.z;\n    trs[2][2] = (cx * cy) * scale.z;\n    trs[2][3] = 0.0;\n\n    trs[3][0] = translation.x;\n    trs[3][1] = translation.y;\n    trs[3][2] = translation.z;\n    trs[3][3] = 1.0;\n\n    return m * trs;\n}\n\nfloat sdBox(vec3 p, vec3 b)\n{\n  vec3 q = abs(p) - b;\n  return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);\n}\n \nfloat map(vec3 p,mat4 matrix)\n{\n  vec3 pt = (matrix * vec4(p, 1.0)).xyz;\n  return sdBox(pt, vec3(1.0));\n}\n \nvec3 calcNormal(vec3 p,mat4 matrix) \n{\n  vec2 e = vec2(0.001, 0.0);\n  return normalize(vec3(\n    map(p + e.xyy, matrix) - map(p - e.xyy, matrix),\n    map(p + e.yxy, matrix) - map(p - e.yxy, matrix),\n    map(p + e.yyx, matrix) - map(p - e.yyx, matrix)\n  ));\n}\n\n// @name rm\n// @param {vec2} uv\n// @param {mat4} mat\n// @param {vec3} pos\n// @returns {vec4}\nvec4 rm(vec2 uv,mat4 matrix,vec3 pos)\n{\n\n  // matrix = transform3d(mat4(1.), vec3(0.3), vec3(3.0), vec3(1.0));\n  vec3 ro = vec3(0.0, 0.0, 4.0);\n  uv = uv * 2.0 - 1.0;\n  vec3 rd = normalize(vec3(uv, -1.5));\n \n  vec3 col = vec3(0.);  \n  float t = 0.0;\n \n  for (int i = 0; i < 100; i++) \n  {\n    vec3 p = ro + rd * t;\n\n// p+=pos;\n    float d = map(p,matrix);\n    if (d < 0.0015)\n    {\n      vec3 n = calcNormal(p, matrix);\n      vec3 lightDir = normalize(vec3(0.6, 0.7, 0.5));\n      float diff = max(dot(n, lightDir), 0.0);\n      float amb = 0.15;\n      float rim = pow(1.0 - max(dot(n, -rd), 0.0), 2.0);\n      col = vec3(0.25, 0.55, 0.95) * (diff + amb) + vec3(0.3, 0.2, 0.5) * rim * 0.4;\n      break;\n    }\n    t += d;\n    if (t > 20.0) break;\n  }\n \n  return vec4(col, 1.0);\n}\n\nuniform vec4 uF6892;\nuniform vec4 uF6910;\nuniform vec4 uF6901;\n\n{{MODULES_HEAD}}\nvoid main()\n{\n\n    vec2 rUv_223=texCoord.xy;\n\n    mat4 rMat4_225=mat4(1.);;\n\n    \n    \n    \n    mat4 rTransform3d_231=transform3d(rMat4_225, uF6892.xyz, uF6910.xyz, uF6901.xyz);\n\n    mat4 rMat4Inverse_226=inverse(rTransform3d_231);\n\n    vec4 rm224=rm(rUv_223, rMat4Inverse_226, vec3(0., 0., 0.));\n\n    vec4 color=rm224;\n\n\noutColor = color;\n\n}"
