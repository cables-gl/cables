          "name": "Final Code",
          "value": "\nIN vec2 texCoord;\nfloat shapeCross(vec2 p,float r,float w)\n{\n    vec2 pp = abs(p);\n    return step(length(pp-min(pp.x+pp.y,w)*vec2(0.5)) - r,0.);\n}\n\nfloat shapeRectRound(vec2 p,vec2 b,float rf)\n{\n    vec4 r = vec4(rf/5.0);\n    r.x  = ( p.x > 0.0) ?r.z:r.x;\n    r.y  = ( p.x > 0.0) ?r.w:r.y;\n    r.x  = ( p.y > 0.0) ?r.y:r.x;\n\nvec2 q = abs(p) - b + r.x;\n      float a=min(max(q.x, q.y), 0.0) + length(max(q, vec2(0.0))) - r.x;\n\n    float aa = fwidth(a);\n    float alpha = 1.0 - smoothstep(-aa, aa, a);\n    return alpha;\n}\n\nuniform vec2 uF5604;\nuniform vec2 uF5613;\nuniform float uF5626;\nuniform float uF5635;\nuniform vec2 uF5644;\n\n{{MODULES_HEAD}}\nvoid main()\n{\n    vec4 col=vec4(0.5,0.5,0.5,1.0);\n        vec2 rUv_196=texCoord.xy;\n\n    \n    vec2 rSum_234=rUv_196+uF5604;\n\n    \n    \n    float rShape2dRectRound_200=shapeRectRound(rSum_234, uF5613, uF5626);\n\n    \n    \n    float rShape2dCross_204=shapeCross(rSum_234, uF5635, uF5644.x);\n\n    float rSubtract_205=rShape2dRectRound_200-rShape2dCross_204;\n\n    vec4 color=vec4(rSubtract_205,rSubtract_205,rSubtract_205, 1.0);\n\n    outColor = color;\n}"
