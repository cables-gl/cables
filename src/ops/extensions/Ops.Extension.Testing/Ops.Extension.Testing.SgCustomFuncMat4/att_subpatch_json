          "value": "\nIN vec2 texCoord;\n \nfloat sdBox(vec3 p, vec3 b)\n{\n  vec3 q = abs(p) - b;\n  return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);\n}\n \nfloat map(vec3 p,mat4 matrix)\n{\n  vec3 pt = (matrix * vec4(p, 1.0)).xyz;\n  return sdBox(pt, vec3(1.0));\n}\n \nvec3 calcNormal(vec3 p,mat4 matrix) \n{\n  vec2 e = vec2(0.001, 0.0);\n  return normalize(vec3(\n    map(p + e.xyy, matrix) - map(p - e.xyy, matrix),\n    map(p + e.yxy, matrix) - map(p - e.yxy, matrix),\n    map(p + e.yyx, matrix) - map(p - e.yyx, matrix)\n  ));\n}\n\n// @name rm\n// @param {vec2} uv\n// @param {mat4} mat\n// @returns {vec4}\nvec4 rm(vec2 uv,mat4 matrix)\n{\n  vec3 ro = vec3(0.0, 0.0, 4.0);\n  vec3 rd = normalize(vec3(uv, -1.5));\n \n  vec3 col = vec3(0.);  \n  float t = 0.0;\n \n  for (int i = 0; i < 100; i++) \n  {\n    vec3 p = ro + rd * t;\n    float d = map(p,matrix);\n    if (d < 0.0015)\n    {\n      vec3 n = calcNormal(p, matrix);\n      vec3 lightDir = normalize(vec3(0.6, 0.7, 0.5));\n      float diff = max(dot(n, lightDir), 0.0);\n      float amb = 0.15;\n      float rim = pow(1.0 - max(dot(n, -rd), 0.0), 2.0);\n      col = vec3(0.25, 0.55, 0.95) * (diff + amb) + vec3(0.3, 0.2, 0.5) * rim * 0.4;\n      break;\n    }\n    t += d;\n    if (t > 20.0) break;\n  }\n \n  return vec4(col, 1.0);\n}\nuniform mat4 uMat4322;\n\n{{MODULES_HEAD}}\nvoid main()\n{\n\n    vec2 rUv_118=texCoord.xy;\n\n    \n    vec4 rm120=rm(rUv_118, uMat4322);\n\n    vec4 color=rm120;\n\n\noutColor = color;\n\n}"
