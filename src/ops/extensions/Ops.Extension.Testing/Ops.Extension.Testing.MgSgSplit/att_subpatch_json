          "name": "Code",
          "value": "{{BINDINGS}}\n\n{{HEADER}}\n\n\n\nfn bump(t: f32) -> f32 {\n    let rise = smoothstep(0.0, 0.5, t);\n    let fall = 1.0 - smoothstep(0.5, 1.0, t);\n    return min(rise, fall);\n}\n\nconst PI: f32 = 3.14159265359;\n\n@vertex\nfn main(\n  @builtin(vertex_index) VertexIndex : u32,\n      @builtin(instance_index) instIdx: u32,\n\n) -> VertexOutput {\n{{MAIN}}    \n    var size:f32=1.;\n\n    var vpos = array<vec2f, 6>(\n      vec2(-size, -size),\n        vec2(size, -size),\n        vec2(-size, size),\n        \n        vec2(size, size),\n        vec2(-size, size),\n        vec2(size, -size)\n    );\n\n  \n    var vuv = array<vec2f, 6>(\n        vec2(0.0, 1.0),\n        vec2(1.0, 1.0),\n        vec2(0.0, 0.0),\n\n        vec2(1.0, 0.0),\n        vec2(0.0, 0.0),\n        vec2(1.0, 1.0)\n    );\n\n      var out: VertexOutput;\n    out.position = cables.mvp * vec4f(vpos[VertexIndex], 0.0, 1.0);\n    out.uv = vuv[VertexIndex];\n    return out;\n  \n  //  return cables.mvp*vec4f(vpos[VertexIndex], 0.0, 1.0);\n\n    // let triangleIndex = VertexIndex / 3u;\n    // let cornerIndex = VertexIndex % 3u;\n    // var pos: vec2<f32>;\n\n    // if (cornerIndex != 0u) {\n    //     let pointOffset = cornerIndex - 1u;\n    //     let segIndex = triangleIndex + pointOffset;\n    //     let angle = (f32(segIndex) / 20) * 2.0 * PI;\n\n    //     pos =  vec2<f32>(cos(angle), sin(angle)) * size;\n    // }\n\n\n    // return cables.mvp*vec4f(pos.x,pos.y,0.0, 1.0);\n    // return vec4f(vpos[VertexIndex], 0.0, 1.0);\n}\n\n"
